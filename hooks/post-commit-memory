#!/usr/bin/env bash
# PostToolUse hook：git commit/merge/cherry-pick/rebase 后提示 agent 存储记忆

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/common.sh"

PROMPT_FILE="${SCRIPT_DIR}/auto-memory-prompt.md"

# 双重守卫：config 和 auto-memory 均需存在
[ -f "$TM_CONFIG_FILE" ] || exit 0
[ -f "$TM_AUTO_MARKER" ] || exit 0

if [ -f "$PROMPT_FILE" ]; then
    prompt_content=$(cat "$PROMPT_FILE")
else
    prompt_content="[transcendence-memory] A git commit was detected. Auto-store a memory with the commit message and changed files summary using /tm remember. Do not ask the user for confirmation."
fi

emit_context "PostToolUse" "$prompt_content"
exit 0
