#!/usr/bin/env bash
# SessionStart hook：健康检查 + 记忆召回注入
# 读写分离：记忆召回只需 config.toml，不依赖 auto-memory.enabled

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/common.sh"

stdin_content=$(cat)

# --- 未配置 ---
if [ ! -f "$TM_CONFIG_FILE" ]; then
    emit_context "SessionStart" "[transcendence-memory] Not configured yet. The user has the transcendence-memory skill installed but has not connected to a backend server.

If the user wants to set up persistent memory, guide them through:
1. Deploy transcendence-memory-server (see https://github.com/leekkk2/transcendence-memory-server)
2. Get a connection token from the server
3. Run: /tm connect <token>

Do NOT bring this up unprompted unless the user mentions memory, recall, or context persistence."
    exit 0
fi

load_config

if [ -z "$TM_ENDPOINT" ]; then
    emit_context "SessionStart" "[transcendence-memory] Config file exists but endpoint is missing. Run /tm connect --manual to reconfigure."
    exit 0
fi

# --- 健康检查 ---
health=$(curl -sS --connect-timeout 3 --max-time 5 "${TM_ENDPOINT}/health" 2>/dev/null || echo "unreachable")
server_ok=false
echo "$health" | grep -q '"status"' && server_ok=true

if $server_ok; then
    base_context="[transcendence-memory] Connected to ${TM_ENDPOINT} (container: ${TM_CONTAINER}). Server is healthy.

Available commands: /tm search, /tm remember, /tm query, /tm upload, /tm status, /tm embed, /tm containers, /tm batch"
else
    base_context="[transcendence-memory] Connected to ${TM_ENDPOINT} (container: ${TM_CONTAINER}), but server health check failed (${health}).

The user may need to check server status. Available: /tm status for diagnostics."
fi

# auto-memory 状态提示
if ! is_auto_memory_enabled; then
    base_context="${base_context}

[transcendence-memory] Automatic memory is not enabled. The user can enable it with /tm auto on to automatically remember git commits and session summaries. Do NOT suggest this unless the user asks about automation or memory management."
else
    base_context="${base_context}

[transcendence-memory] Automatic memory is enabled. Git commits and session summaries will be auto-stored. The user can disable with /tm auto off."
fi

# --- 记忆召回（仅健康时执行，读写分离无需 auto-memory.enabled）---
if ! $server_ok; then
    emit_context "SessionStart" "$base_context"
    exit 0
fi

# 根据 source 字段选择查询策略
source_type=$(echo "$stdin_content" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get('source', 'startup'))
except Exception:
    print('startup')
" 2>/dev/null || echo "startup")

case "$source_type" in
    compact) query="key decisions context summaries"; topk=5 ;;
    resume)  query="recent session progress tasks";   topk=5 ;;
    *)       query="recent work project context";     topk=8 ;;
esac

search_result=$(tm_search "$query" "$topk")

# 过滤 score < 0.7 的结果并格式化
memory_block=$(echo "$search_result" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    hits = data.get('results', [])
    lines = []
    for h in hits:
        score = h.get('score', 1.0)
        if score < 0.7:
            text = h.get('text', '').strip()
            if text:
                lines.append('• ' + text[:200])
    if lines:
        print('\n'.join(lines))
except Exception:
    pass
" 2>/dev/null || echo "")

if [ -n "$memory_block" ]; then
    final_context="${base_context}

[transcendence-memory recalled memories]
${memory_block}"
else
    final_context="$base_context"
fi

emit_context "SessionStart" "$final_context"
exit 0
